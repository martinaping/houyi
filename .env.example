# ============================================
# houyi 环境变量示例
# 复制为 .env（不要提交到 Git）并按需填写。
#
# 配置优先级：环境变量 > 管理后台（admin_config） > 代码默认值
# 即：这里留空的业务参数可以在管理后台填写；这里填了值，管理后台对应项会变为只读。
# 基础设施连接（MySQL/Redis）与加密主密钥只能通过环境变量配置。
# ============================================

# ============================================
# 加密主密钥（必填，若需要在管理后台保存 AK/SK、Secret）
# 建议：openssl rand -base64 32
# 变更后旧密文将无法解密，需在后台重新填写敏感项。
# ============================================
HOUYI_CONFIG_KEY=

# ============================================
# 阿里云 OSS（管理后台：设置 → 阿里云 OSS，重启主服务生效）
# ============================================
ALIYUN_OSS_BUCKET=wechat-monitoring
ALIYUN_OSS_ENDPOINT=oss-cn-shanghai.aliyuncs.com
# 生产环境内网 Endpoint，留空则沿用 ALIYUN_OSS_ENDPOINT
ALIYUN_OSS_ENDPOINT_INTERNAL=oss-cn-shanghai-internal.aliyuncs.com
ALIYUN_OSS_ACCESS_KEY=
ALIYUN_OSS_ACCESS_SECRET=

# ============================================
# 阿里云 MNS 备份队列（管理后台：设置 → 阿里云 MNS，重启主服务生效）
# 主消息发送成功后异步备份一份到 MNS；未配置时自动跳过，不影响主链路
# ============================================
ALIYUN_MNS_ENABLED=true
ALIYUN_MNS_ENDPOINT=
ALIYUN_MNS_QUEUE_NAME=houyi-msgs
ALIYUN_MNS_ACCESS_KEY=
ALIYUN_MNS_ACCESS_SECRET=

# ============================================
# MySQL（仅环境变量，管理后台不可配置）
# ============================================
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=houyi
MYSQL_USERNAME=root
MYSQL_PASSWORD=

# ============================================
# Redis（仅环境变量，管理后台不可配置）
# ============================================
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# ============================================
# Redis 消息队列（管理后台：设置 → Redis 消息队列，重启主服务生效）
# REDIS_MQ_ENABLED=true 使用 Redis；false 时主应用使用 RocketMQ
# ============================================
REDIS_MQ_ENABLED=true
REDIS_MQ_TOPIC=mq:topic:main
REDIS_MQ_RETRY_TOPIC=mq:topic:retry
REDIS_MQ_DELAY_QUEUE_KEY=mq:delay:queue
REDIS_MQ_CONSUMER_GROUP=houyi-consumer-group
REDIS_MQ_RETRY_CONSUMER_GROUP=houyi-retry-consumer-group
REDIS_MQ_TAG=default
REDIS_MQ_RETRY_DELAY_MS=30000
REDIS_MQ_BATCH_SIZE=10
REDIS_MQ_POLL_INTERVAL_MS=1000
REDIS_MQ_DELAY_SCAN_INTERVAL_MS=1000
REDIS_MQ_ENABLE_BACKUP=true

# ============================================
# RocketMQ 5.x（gRPC Proxy，非 NameServer 9876）
# 主应用与管理后台手动重试共用；管理后台也可在线填写 endpoint/用户名/密码
# ============================================
ROCKETMQ_ENDPOINT=http://127.0.0.1:8081
ROCKETMQ_USERNAME=
ROCKETMQ_PASSWORD=
ROCKETMQ_TOPIC=wechat-archive-msg
ROCKETMQ_RETRY_TOPIC=wechat-archive-retry
ROCKETMQ_GROUP_ID=
ROCKETMQ_RETRY_GROUP_ID=
ROCKETMQ_TAG=ChatDataJava
ROCKETMQ_RETRY_DELAY_MS=30000

# ============================================
# 企业微信（推荐直接在管理后台「企业」页面维护，写入数据库后热加载）
# 这里仅作首次启动的引导配置，可选。
# ============================================
# WEWORK_CORPS_0_ID=
# WEWORK_CORPS_0_NAME=
# WEWORK_CORPS_0_SECRET=
# WEWORK_CORPS_0_PRIVATE_KEY=
# WEWORK_CORPS_0_ENABLED=true

# ============================================
# 主应用服务器与线程池
# ============================================
SERVER_PORT=8080
LOG_PATH=/tmp/
THREAD_POOL_DOWNLOAD_CORE_SIZE=8
THREAD_POOL_DOWNLOAD_MAX_SIZE=100
THREAD_POOL_DOWNLOAD_QUEUE_CAPACITY=10000
THREAD_POOL_OSS_CORE_SIZE=4
THREAD_POOL_OSS_MAX_SIZE=60
THREAD_POOL_OSS_QUEUE_CAPACITY=10000

# ============================================
# 管理后台（admin-server，独立部署）
# ============================================
ADMIN_PASSWORD=
ADMIN_JWT_SECRET=
DB_URL=jdbc:h2:file:./db/houyi;MODE=MySQL;DATABASE_TO_LOWER=TRUE;CASE_INSENSITIVE_IDENTIFIERS=TRUE;AUTO_SERVER=TRUE
DB_USERNAME=sa
DB_PASSWORD=
